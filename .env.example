# Параметры приложения
APP_NAME=CheckIn Backend Service
APP_VERSION=1.0.0
HOST=0.0.0.0
HTTP_PORT=8080

# Подключение приложения к PostgreSQL
# В Docker Compose DB_HOST должен быть именем сервиса: db
DB_HOST=db
DB_PORT=5432
DB_USER=checkin_user
DB_PASSWORD=CheckIn2026Pass
DB_NAME=checkin_db
DB_MAX_CONNS=10

# Порт PostgreSQL на хост-машине (внутри Docker остаётся 5432)
DB_HOST_PORT=5433
